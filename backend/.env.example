PROJECT_NAME=SonicStream API
VERSION=1.0.0
API_V1_STR=/api/v1

# Option A: store service account as JSON string
# FIREBASE_SERVICE_ACCOUNT={...}

# Option B: point to mounted local file (dev only)
FIREBASE_CREDENTIALS_PATH=backend/serviceAccountKey.json

MODEL_PATH_HNN=recommendation_engine/hnn_model.pth
MODEL_PATH_MF=recommendation_engine/mf_model.pth
EMBEDDINGS_PATH=recommendation_engine/final_embeddings.pt

# Comma-separated Firebase UIDs for privileged sync endpoint
ADMIN_UIDS=

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_READ_MAX=180
RATE_LIMIT_WRITE_MAX=60
